<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/divider"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header: Title and Status Badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtListingTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="Samsung Galaxy S24 (128GB)"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtModerationBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_status_best_deal"
                android:paddingStart="8dp"
                android:paddingTop="4dp"
                android:paddingEnd="8dp"
                android:paddingBottom="4dp"
                android:text="Active"
                android:textColor="#166534"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Provider and Locality -->
        <TextView
            android:id="@+id/txtListingProviderAndArea"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Apex Electronics • Koramangala"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <!-- Category Tag & Subcategory -->
        <TextView
            android:id="@+id/txtListingCategoryTag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Electronics &amp; Appliances • Smartphones"
            android:textColor="@color/text_tertiary"
            android:textSize="12sp" />

        <!-- Rejection / Suspension Notice -->
        <TextView
            android:id="@+id/txtRejectionNotice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="#FEF2F2"
            android:padding="8dp"
            android:text="Reason: Inaccurate price. Please update with store proof."
            android:textColor="#991B1B"
            android:textSize="11sp"
            android:visibility="gone" />

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:background="@color/divider" />

        <!-- Price & Action Buttons Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtListingPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="₹74,999"
                    android:textColor="@color/primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtPriceTypeName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Selling Price"
                    android:textColor="@color/text_tertiary"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Report Button (Phase 8.6) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnReportListing"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:minWidth="0dp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:text="Report"
                android:textColor="@color/text_tertiary"
                android:textSize="11sp" />

            <!-- Edit Button (Phase 8.2) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEditListing"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:minWidth="0dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="Edit"
                android:textColor="@color/primary"
                android:textSize="12sp" />

            <!-- Delete Button (Phase 8.3) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDeleteListing"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:minWidth="0dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="Delete"
                android:textColor="#DC2626"
                android:textSize="12sp" />

            <!-- Admin Moderate Button (Phase 8.5) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnModerateListing"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="4dp"
                android:minWidth="0dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="Moderate"
                android:textColor="@color/text_primary"
                android:textSize="11sp"
                app:strokeColor="@color/divider" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
