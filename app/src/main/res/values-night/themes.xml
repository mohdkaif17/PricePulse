<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme (enforces light theme consistency across all device modes). -->
    <style name="Base.Theme.PricePulse" parent="Theme.Material3.Light.NoActionBar">
        <!-- Primary Brand Colors -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant" tools:ignore="PrivateResource">@color/primary_variant</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorPrimaryContainer">@color/primary_container</item>
        <item name="colorOnPrimaryContainer">@color/on_primary_container</item>

        <!-- Secondary / Accent Colors -->
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorSecondaryVariant" tools:ignore="PrivateResource">@color/secondary_variant</item>
        <item name="colorOnSecondary">@color/on_secondary</item>
        <item name="colorSecondaryContainer">@color/secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/on_secondary_container</item>

        <!-- Status & Error Colors -->
        <item name="colorError">@color/price_overpriced</item>
        <item name="colorOnError">@color/white</item>

        <!-- Background & Surface Colors -->
        <item name="android:windowBackground">@color/background_light</item>
        <item name="android:colorBackground">@color/background_light</item>
        <item name="colorSurface">@color/surface_light</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/surface_variant_light</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>

        <!-- System Bar Theming -->
        <item name="android:statusBarColor">@color/background_light</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/background_light</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
    </style>

    <style name="Theme.PricePulse" parent="Base.Theme.PricePulse" />
</resources>