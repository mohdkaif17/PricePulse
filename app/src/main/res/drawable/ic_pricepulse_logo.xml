            <gradient
                android:startX="18"
                android:startY="57"
                android:endX="76"
                android:endY="32"
                android:type="linear">
                <item android:offset="0.0" android:color="#38BDF8"/>
                <item android:offset="0.45" android:color="#22D3EE"/>
                <item android:offset="1.0" android:color="#10B981"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- Upward Growth Arrowhead at (76, 32) -->
    <path
        android:pathData="M66,32 L76,32 L76,42"
        android:strokeColor="#10B981"
        android:strokeWidth="4"
        android:strokeLineCap="round"
