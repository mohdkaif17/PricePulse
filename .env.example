# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=price_comparison
DB_USER=postgres
DB_PASSWORD=your_secure_password_here
DB_SCHEMA=public

# Android Emulator accessibility
# In the Android emulator, '10.0.2.2' points to the development host's 'localhost'
HOST_IP_FOR_EMULATOR=10.0.2.2

# Application Environment
APP_ENV=development
APP_DEBUG=true
API_PORT=8000
