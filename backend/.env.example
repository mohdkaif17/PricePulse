# PricePulse Backend Configuration Template
PROJECT_NAME="PricePulse API"
API_V1_STR="/api/v1"
APP_ENV=development
APP_DEBUG=true
API_PORT=8000
HOST_IP_FOR_EMULATOR=10.0.2.2

# Unified Database URL (Preferred for Render, Railway, Supabase or Cloud PostgreSQL)
# Example Render URL: postgres://user:password@dpg-xxxxxxxx-a.oregon-postgres.render.com/price_comparison?sslmode=require
# DATABASE_URL=postgresql://user:password@host:5432/price_comparison

# Discrete Database Configuration (Used when DATABASE_URL is not set)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=price_comparison
DB_USER=postgres
DB_PASSWORD=your_secure_password_here
DB_SCHEMA=public

# Database SSL & Connection Pooling (Optional, defaults auto-detected)
# DB_SSL=true
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Security & Authentication
SECRET_KEY=your_secret_key_minimum_32_characters_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
